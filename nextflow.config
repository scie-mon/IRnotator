params {
    /*
     * Input modes are inferred from supplied paths:
     *
     * 1. --proteins_faa
     * 2. --genome_fasta + --annot_gff
     * 3. --proteins_faa + --annot_gff
     *
     * Supplying all three is invalid.
     */
    proteins_faa          = null
    genome_fasta          = null
    annot_gff             = null

    gff_protein_attribute = 'protein_id'
    translation_table     = 1
    allow_internal_stops  = false
    normalizer_container  = 'quay.io/biocontainers/biopython:1.84'

    hmm_dir               = 'test/hmms'
    outdir                = 'results'
    hmm_evalue            = '1e-5'
    hmmer_container       = 'biocontainers/hmmer:v3.2.1dfsg-1-deb_cv1'

    deeptmhmm_mode        = 'container'  // container only at present
    deeptmhmm_model       = 'DTU/DeepTMHMM:1.0.24'
    deeptmhmm_dir         = null
    deeptmhmm_container   = 'interpro/deeptmhmm:1.0'
    deeptmhmm_keep_going  = false
    deeptmhmm_gpu         = false

    manual_review         = false
}

process {
    executor = 'local'
    cpus     = 48
    memory   = '200 GB'
    time     = '48h'

    withName: NORMALIZE_PROTEINS {
        container = params.normalizer_container
        cpus      = 1
        memory    = '4 GB'
        time      = '2h'
    }

    withName: NORMALIZE_GENOME_GFF {
        container = params.normalizer_container
        cpus      = 1
        memory    = '8 GB'
        time      = '4h'
    }

    withName: NORMALIZE_PROTEINS_GFF {
        container = params.normalizer_container
        cpus      = 1
        memory    = '4 GB'
        time      = '2h'
    }

    withName: HMMSEARCH_IR {
        container = params.hmmer_container
    }

    withName: DEEPTMHMM_TOPOLOGY {
        cpus             = 8
        memory           = '32 GB'
        time             = '24h'
        container        = params.deeptmhmm_mode == 'container' ? params.deeptmhmm_container : null
        containerOptions = params.deeptmhmm_gpu ? '--gpus all' : ''
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled    = true
        apptainer.enabled = false
    }

    apptainer {
        docker.enabled      = false
        apptainer.enabled   = true
        apptainer.autoMounts = true

        process {
            withName: DEEPTMHMM_TOPOLOGY {
                containerOptions = params.deeptmhmm_gpu ? '--nv' : ''
            }
        }
    }
}
