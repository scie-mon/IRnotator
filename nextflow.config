params {
    /*
     * Supported input modes:
     * 1. --proteins_faa
     * 2. --genome_fasta + one or more --annot_gff files
     */
    proteins_faa             = null
    genome_fasta             = '/home/primeline/Data/IRnotator/test/multi_gff/genome/GCA_030254905.1_UOB_LRV0_1_genomic.fna'
    annot_gff                = '/home/primeline/Data/IRnotator/test/multi_gff/annotations/*.gff'

    gff_protein_attribute    = 'protein_id'
    translation_table        = 1
    allow_internal_stops     = false
    isoform_overlap_fraction = 0.60

    normalizer_container     = 'quay.io/biocontainers/biopython:1.84'

    hmm_dir                  = 'test/hmms'
    outdir                   = 'mulit_GFF_test2'
    hmm_evalue               = '1e-5'
    hmmer_container          = 'biocontainers/hmmer:v3.2.1dfsg-1-deb_cv1'

    deeptmhmm_mode           = 'container'
    deeptmhmm_model          = 'DTU/DeepTMHMM:1.0.24'
    deeptmhmm_dir            = null
    run_deeptmhmm            = true
    deeptmhmm_salvage_paths  = ['/home/primeline/Data/maker/metagenome/12_Dmagna_LRV']
    deeptmhmm_container      = 'interpro/deeptmhmm:1.0'
    deeptmhmm_keep_going     = false
    deeptmhmm_gpu            = false

    // Optional path to a completed manual-review export.
    // If omitted, <outdir>/manual_review/review.tsv is used when present.
    review_tsv               = null
}

process {
    executor = 'local'
    cpus     = 48
    memory   = '200 GB'
    time     = '48h'

    withName: NORMALIZE_PROTEINS {
        container = params.normalizer_container
        cpus      = 1
        memory    = '4 GB'
        time      = '2h'
    }

    withName: NORMALIZE_MULTI_GENOME_GFF {
        container = params.normalizer_container
        cpus      = 1
        memory    = '8 GB'
        time      = '6h'
    }

    withName: MERGE_UNFILTERED {
        container = params.normalizer_container
        cpus      = 1
        memory    = '8 GB'
        time      = '4h'
    }

    withName: MERGE_FILTERED {
        container = params.normalizer_container
        cpus      = 1
        memory    = '8 GB'
        time      = '4h'
    }

    withName: PREPARE_MANUAL_REVIEW {
        container = params.normalizer_container
        cpus      = 1
        memory    = '4 GB'
        time      = '4h'
    }

    withName: HMMSEARCH_IR {
        container = params.hmmer_container
    }

    withName: DEEPTMHMM_TOPOLOGY {
        cpus             = 8
        memory           = '32 GB'
        time             = '24h'
        errorStrategy    = params.deeptmhmm_keep_going ? 'ignore' : 'terminate'
        container        = params.deeptmhmm_mode == 'container' ? params.deeptmhmm_container : null
        containerOptions = params.deeptmhmm_gpu ? '--gpus all' : ''
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled    = true
        apptainer.enabled = false
    }

    apptainer {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true

        process {
            withName: DEEPTMHMM_TOPOLOGY {
                containerOptions = params.deeptmhmm_gpu ? '--nv' : ''
            }
        }
    }
}
