params {
    input  = 'assets/test_input.txt'
    outdir = 'results'
}

process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '1h'
}

profiles {
    local {
        process {
            executor = 'local'
        }
    }

    cluster {
        process {
            executor = 'slurm'
            cpus = 1
            memory = '1 GB'
            time = '1h'
        }
    }
}
